# ─────────────────────────────────────────────────────────────────────────────
# BACKEND PRODUCTION ENV (RAILWAY)
# ─────────────────────────────────────────────────────────────────────────────

# URL de la base de datos (Railway te proporcionará una)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/cadastral"

# Puerto para el servidor (Railway lo configura automáticamente vía variable PORT)
PORT=4000

# URL del frontend para CORS
FRONTEND_URL="https://tu-frontend.up.railway.app"

# API Key de Google (Opcional si usas el seed maestro, obligatoria para geolocalización manual)
GOOGLE_GEOCODING_API_KEY="AIzaSy..."

# JWT Secret para sesión
JWT_SECRET="una-clave-muy-segura-y-aleatoria"
