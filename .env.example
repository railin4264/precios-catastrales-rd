# ==================================================
# Precios Catastrales RD — Variables de Entorno
# Copia este archivo a .env y llena los valores
# NUNCA commitees el .env real al repositorio
# ==================================================

# ----- BASE DE DATOS -----
POSTGRES_USER=user
POSTGRES_PASSWORD=CAMBIA_ESTO_EN_PRODUCCION
POSTGRES_DB=cadastral

# ----- BACKEND -----
PORT=4000
DATABASE_URL=postgresql://user:CAMBIA_ESTO_EN_PRODUCCION@postgres:5432/cadastral?schema=public
JWT_SECRET=GENERA_UN_SECRETO_DE_64_CARACTERES_AQUI
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ----- GOOGLE MAPS -----
# Usada en el BACKEND para geocodificar sectores (Google Geocoding API)
# Restringir a: APIs -> Geocoding API, IP del servidor
GOOGLE_GEOCODING_API_KEY=TU_API_KEY_AQUI

# Usada en el FRONTEND para el mapa interactivo (Maps JavaScript API)
# Restringir a: APIs -> Maps JavaScript API, HTTP referrers de tu dominio
NEXT_PUBLIC_GOOGLE_MAPS_KEY=TU_API_KEY_AQUI

# ----- PAGOS (a futuro) -----
# PAYMENT_SECRET_KEY=

# ----- CONTACTO -----
CONTACT_WHATSAPP=+1-809-000-0000

# ----- FRONTEND -----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ----- CORS -----
FRONTEND_URL=http://localhost:3000

# ----- ADMIN -----
ADMIN_BOOTSTRAP_SECRET=cadastral_admin_bootstrap_CAMBIA_ESTO

